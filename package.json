{
  "name": "tw-landing-bundle",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "predev": "pnpm run audit:defaults && pnpm run audit:runtime-defaults && pnpm run audit:localized",
    "dev": "vite",
    "prebuild": "pnpm run audit:defaults && pnpm run audit:runtime-defaults && pnpm run audit:localized",
    "build": "vite build",
    "audit:defaults": "node scripts/audit-default-values.mjs",
    "audit:runtime-defaults": "node scripts/audit-runtime-defaults.mjs",
    "fix:defaults": "node scripts/audit-default-values.mjs --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "preview": "vite preview",
    "audit:localized": "node scripts/audit-localized-strings.mjs",
    "postbuild": "node scripts/audit-localized-strings.mjs --dist"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vite": "^5.0.0",
    "vitest": "^3.0.5",
    "@salla.sa/twilight-bundles": "^0.1.62"
  },
  "author": "Badrbadhri+growth@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/badhri17/tw-landing-bundle"
  },
  "private": true,
  "dependencies": {
    "@salla.sa/twilight-bundles-starter-kit": "^0.1.56",
    "lit": "^3.2.1",
    "@salla.sa/twilight-bundles": "0.1.62"
  }
}
