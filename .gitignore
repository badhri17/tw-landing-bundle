# Dependencies
node_modules/

# Build output — Twilight CI requires the per-component JS to be committed
# (the bundle is released from dist/). dist/assets/ is ignored because it is
# a build copy of public/assets/, which is no longer tracked either.
dist/*
!dist/*.js

# tw-preview snapshot id + write key (machine-local, not shareable)
.salla-preview.json*

# Generated by `pnpm assets:list` — a scratch skeleton for the CDN migration
assets-map.json

# Editor / OS noise
.DS_Store
*.log

# Local scratch/injection script — not part of the bundle
test.js

# Media lives on the tw-preview CDN, not in the repository: Salla builds
# theme.zip from the committed files and caps a public bundle at 1 MB, which
# these two directories blew by 5x on their own. Both stay on disk — the
# bundle points at them again after `pnpm assets:local`. See "Bundle size"
# in CLAUDE.md.
public/assets/
templates-thumbs/
